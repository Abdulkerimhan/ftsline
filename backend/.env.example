# =========================
# SERVER
# =========================
NODE_ENV=production
PORT=5000

# Public backend URL used for generated upload URLs.
# Example: https://ftsline-api.onrender.com
PUBLIC_API_URL=https://your-backend-domain.com

# =========================
# DATABASE - MongoDB Atlas
# =========================
# Replace username, password and cluster/database with your Atlas values.
# Example format:
# mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/ftsline?retryWrites=true&w=majority&appName=<APP_NAME>
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/ftsline?retryWrites=true&w=majority

# =========================
# JWT
# =========================
# Use a long random value in production. Do not commit the real value.
JWT_SECRET=replace_with_a_long_random_secret

# =========================
# FRONTEND / CORS
# =========================
# Your live frontend URL. For multiple origins, separate with commas.
# Example: https://ftsline.vercel.app,https://www.ftsline.com
CLIENT_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com

# =========================
# MAIL - OPTIONAL
# =========================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=FTSLine <no-reply@example.com>

# =========================
# UPLOADS
# =========================
# Optional. Leave empty to use backend/uploads/products.
UPLOAD_DIR=
# =========================
# USDT MANUAL PAYMENT - OPTIONAL
# =========================
USDT_TRC20_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDT_NETWORK=TRC20